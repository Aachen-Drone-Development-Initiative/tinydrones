menu "ADC configuration"
    config BATTERY_GUARD
        bool "Enable Battery Guard"
        default y
        help 
            Enables periodic checks of battery charge and shutsdown when low.

    config BATTERY_MIN #IMPORTANT gives mV value as float is not supported
        int "Minimum Voltage"
        depends on BATTERY_GUARD
        default 3100
        help
            Number given in mV as Kconfig v2 which is currently in use does not support float

    config BATTERY_CHECK_PERIOD
        int "Battery check period"
        default 5000
        help 
          Number of ms between automatic battery voltage checks
endmenu
